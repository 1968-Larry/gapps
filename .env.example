# Copy to .env and fill in. Never commit .env.
# Read by docker-compose.yml via env_file (see docker-compose.override.yml.example).

# --- database -------------------------------------------------------------
# Changing POSTGRES_PASSWORD later does NOT change the password of an
# already initialised database.
POSTGRES_USER=db1
POSTGRES_PASSWORD=db1
POSTGRES_DB=db1
POSTGRES_HOST=postgres

# --- app ------------------------------------------------------------------
APP_NAME=Gapps
HOST_NAME=https://gapps.example.com
# Required: gapps refuses to start with an empty or the default key.
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_secret_key
DEFAULT_EMAIL=admin@example.com
DEFAULT_PASSWORD=change_me_now

# --- Microsoft / ADFS login -----------------------------------------------
ENABLE_MICROSOFT_AUTH=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# On-prem ADFS: host name only (sts.example.com). Empty = Entra ID / Azure AD.
ADFS_SERVER=
# Entra ID only, optional (defaults to "common")
MICROSOFT_TENANT_ID=

# --- session timeouts -------------------------------------------------------
# Logged out after this many minutes without activity (a warning dialog is
# shown 2 minutes before) and this many hours after login whatever the
# activity (warning 10 minutes before). 0 = off.
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=4
# Session cookie only over https. Defaults to on when HOST_NAME is https.
# SESSION_COOKIE_SECURE=true

# --- audit log ------------------------------------------------------------
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=/var/log/app/audit.log
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_TRUST_FORWARDED_FOR=true
# Important events are also shown on the GUI Logs page
AUDIT_GUI_ENABLED=true
AUDIT_GUI_RETENTION_DAYS=90
# AUDIT_GUI_EVENTS=login_failed,access_denied,resource_deleted:Project

# --- risk review rhythm -----------------------------------------------------
# Months until the next review per risk level; sets the suggested "next review"
# date on new risks and when a risk is marked as reviewed. Leave a level out
# (or use 0) for no automatic date.
RISK_REVIEW_INTERVALS=very high=3,high=6,low=12,very low=12

# --- risk reminder emails ----------------------------------------------------
# Sent by tools/send_risk_reminders.py, which you run once a day, for example
#   30 7 * * *  docker exec <app-container> python3 tools/send_risk_reminders.py
# Try it first with --dry-run. The normal MAIL_* settings are used to send.
# Who gets the mail (comma list): assignee, project_managers, tenant_owner,
# risk_managers, ciso, or fixed email addresses.
RISK_REMINDER_TO=assignee
RISK_REMINDER_CC=
# Used when TO resolves to nobody for a risk (for example no assignee)
RISK_REMINDER_FALLBACK_TO=risk_managers
# First reminder this many days before the review/due date
RISK_REMINDER_DAYS_BEFORE=7
# After the date has passed, repeat every N days (0 = do not repeat)
RISK_REMINDER_OVERDUE_REPEAT_DAYS=7
# Never mail these domains (and subdomains). Default protects the demo tenant users.
RISK_REMINDER_EXCLUDE_DOMAINS=demo.example.com
# Public address of the app, used for the links in the emails
APP_BASE_URL=https://grc.example.com

# --- exceptions (deviations) -------------------------------------------------
# Longest allowed validity from approval, in months (0 = no limit)
EXCEPTION_MAX_VALIDITY_MONTHS=12
# Show "expiring soon" this many days before the expiry date
EXCEPTION_EXPIRING_SOON_DAYS=30
# Who approves which level. Approvers from low to high: project_manager,
# riskmanager (shown as "Security manager"), ciso. A higher approver may also
# approve lower levels. Admins only approve when nobody (other than the
# requester) holds the required role.
EXCEPTION_APPROVERS=very high=ciso,high=ciso,low=riskmanager,very low=riskmanager
# Let the person who requested an exception approve it too (one-person setups only)
EXCEPTION_ALLOW_SELF_APPROVAL=false
# Expiry reminders are sent by tools/send_risk_reminders.py with the RISK_REMINDER_*
# settings above (recipients, days before, repeat). false = only risk reminders.
EXCEPTION_REMINDERS_ENABLED=true

# --- login protection and headers -----------------------------------------
# Lock a local account for LOGIN_LOCK_MINUTES after LOGIN_MAX_FAILED wrong
# passwords in a row (0 = off)
LOGIN_MAX_FAILED=10
LOGIN_LOCK_MINUTES=15
# Strict-Transport-Security max-age (seconds) when HOST_NAME is https, 0 = off
HSTS_MAX_AGE=31536000

# --- browser libraries (CSS/JS) ----------------------------------------------
# local = served by the app from app/static/vendor (on-prem / air-gapped)
# cdn   = loaded from ASSET_CDN_URL, same versions, checked with SRI hashes
ASSET_MODE=local
# npm CDN with the jsDelivr URL layout (<url>/<package>@<version>/<file>)
# ASSET_CDN_URL=https://cdn.jsdelivr.net/npm
# Content-Security-Policy header: off, report-only (violations only shown in
# the browser console, F12) or enforce
CSP_MODE=report-only

# --- internal pip mirror for "docker compose build" (empty = pypi.org) ------
# PIP_INDEX_URL=https://nexus.example.com/repository/pypi/simple
# PIP_TRUSTED_HOST=nexus.example.com

# --- outbound proxy (runtime only, not used by "docker compose build") ----
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=postgres,localhost,127.0.0.1
# REQUESTS_CA_BUNDLE=/path/in/container/ca.pem

# --- host paths for bind mounts (option B in docker-compose.override.yml.example)
# DATA_DIR=/srv/gapps
