# Copy to .env and fill in. Never commit .env.
# Read by docker-compose.yml via env_file (see docker-compose.override.yml.example).

# --- database -------------------------------------------------------------
# Changing POSTGRES_PASSWORD later does NOT change the password of an
# already initialised database.
POSTGRES_USER=db1
POSTGRES_PASSWORD=db1
POSTGRES_DB=db1
POSTGRES_HOST=postgres

# --- app ------------------------------------------------------------------
APP_NAME=Gapps
HOST_NAME=https://gapps.example.com
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_secret_key
DEFAULT_EMAIL=admin@example.com
DEFAULT_PASSWORD=change_me_now

# --- Microsoft / ADFS login -----------------------------------------------
ENABLE_MICROSOFT_AUTH=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# On-prem ADFS: host name only (sts.example.com). Empty = Entra ID / Azure AD.
ADFS_SERVER=
# Entra ID only, optional (defaults to "common")
MICROSOFT_TENANT_ID=

# --- audit log ------------------------------------------------------------
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=/var/log/app/audit.log
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_TRUST_FORWARDED_FOR=true
# Important events are also shown on the GUI Logs page
AUDIT_GUI_ENABLED=true
AUDIT_GUI_RETENTION_DAYS=90
# AUDIT_GUI_EVENTS=login_failed,access_denied,resource_deleted:Project

# --- risk review rhythm -----------------------------------------------------
# Months until the next review per risk level; sets the suggested "next review"
# date on new risks and when a risk is marked as reviewed. Leave a level out
# (or use 0) for no automatic date.
RISK_REVIEW_INTERVALS=very high=3,high=6,low=12,very low=12

# --- risk reminder emails ----------------------------------------------------
# Sent by tools/send_risk_reminders.py, which you run once a day, for example
#   30 7 * * *  docker exec <app-container> python3 tools/send_risk_reminders.py
# Try it first with --dry-run. The normal MAIL_* settings are used to send.
# Who gets the mail (comma list): assignee, project_managers, tenant_owner,
# risk_managers, or fixed email addresses.
RISK_REMINDER_TO=assignee
RISK_REMINDER_CC=
# Used when TO resolves to nobody for a risk (for example no assignee)
RISK_REMINDER_FALLBACK_TO=risk_managers
# First reminder this many days before the review/due date
RISK_REMINDER_DAYS_BEFORE=7
# After the date has passed, repeat every N days (0 = do not repeat)
RISK_REMINDER_OVERDUE_REPEAT_DAYS=7
# Never mail these domains (and subdomains). Default protects the demo tenant users.
RISK_REMINDER_EXCLUDE_DOMAINS=demo.example.com
# Public address of the app, used for the links in the emails
APP_BASE_URL=https://grc.example.com

# --- outbound proxy (runtime only, not used by "docker compose build") ----
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=postgres,localhost,127.0.0.1
# REQUESTS_CA_BUNDLE=/path/in/container/ca.pem

# --- host paths for bind mounts (option B in docker-compose.override.yml.example)
# DATA_DIR=/srv/gapps
